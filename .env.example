# Vector Agent SDK Configuration
VECTOR_OGMIOS_URL=https://ogmios.vector.testnet.apexfusion.org
VECTOR_SUBMIT_URL=https://submit.vector.testnet.apexfusion.org/api/submit/tx
VECTOR_KOIOS_URL=https://v2.koios.vector.testnet.apexfusion.org/
VECTOR_EXPLORER_URL=https://vector.testnet.apexscan.org
# Identity registry (vector_agent.identity). The endpoints above are the testnet,
# which has no published identity deployment. On mainnet (the default), unset
# VECTOR_IDENTITY_* values take the published values (MAINNET_IDENTITY_DEPLOYMENT).
VECTOR_IDENTITY_NETWORK=testnet

# Wallet
VECTOR_MNEMONIC=word1 word2 ... word15
VECTOR_ACCOUNT_INDEX=0

# Safety Limits (lovelace)
VECTOR_SPEND_LIMIT_PER_TX=100000000
VECTOR_SPEND_LIMIT_DAILY=500000000

# MCP Server (Streamable HTTP - connect to hosted Vector MCP at /mcp)
# Testnet:
VECTOR_MCP_URL=https://mcp.vector.testnet.apexfusion.org/mcp
# Mainnet:
# VECTOR_MCP_URL=https://mcp.vector.mainnet.apexfusion.org/mcp

# Self-Improvement module (Module-6) on the deployment that reads identity records.
# The new deployment is not live, so there are no defaults. Either name the deploy
# state of Module-6/scripts/deploy.py, or set the values one by one.
# VECTOR_MODULE6_DEPLOY_STATE=/path/to/deploy_state.json
# VECTOR_MODULE6_IDENTITY_HASH=
# VECTOR_MODULE6_RECORD_TOKEN_POLICY=
# VECTOR_MODULE6_REFS_TOKEN_POLICY=
# VECTOR_MODULE6_ORACLE_HOLDER_HASH=
# VECTOR_MODULE6_PARAMS_HOLDER_HASH=
# VECTOR_MODULE6_TREASURY_HOLDER_HASH=
# VECTOR_MODULE6_PROPOSAL_SPEND_REF_UTXO=<tx id>#<index>
# VECTOR_MODULE6_PROPOSAL_MINT_REF_UTXO=<tx id>#<index>
# VECTOR_MODULE6_CRITIQUE_SPEND_REF_UTXO=<tx id>#<index>
# VECTOR_MODULE6_CRITIQUE_MINT_REF_UTXO=<tx id>#<index>
# VECTOR_MODULE6_ENDORSEMENT_SPEND_REF_UTXO=<tx id>#<index>
